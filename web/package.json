{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['.next', '.turbo', 'out'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true});console.log('[Clean] Purged '+p)}catch(e){}})\"",
    "clean:dev": "npm run clean && next dev",
    "clean:build": "npm run clean && next build",
    "dev": "next dev",
    "dev:admin": "next dev -p 3001",
    "dev:partner": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "prisma": "6.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
